        <mxCell id="approve-deploy" value="" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52667b;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=0;labelBackgroundColor=#ffffff;fontColor=#34495e;" edge="1" parent="1" source="approve" target="deploy">
