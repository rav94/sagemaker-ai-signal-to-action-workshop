          <mxGeometry as="geometry" x="45" y="19" width="1160" height="34" />
        </mxCell>
        <mxCell id="subtitle" value="Dispatch the same GitHub workflow for a second approved package. SageMaker keeps the baseline fleet during monitoring." style="text;align=left;verticalAlign=middle;fontSize=16;fontColor=#51647a;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="57" width="1160" height="22" />
