  <diagram name="Native pipeline to verified endpoint" id="training-to-endpoint">
    <mxGraphModel dx="1380" dy="650" grid="1" page="1" pageWidth="1260" pageHeight="568">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Native SageMaker Pipeline to verified endpoint" style="text;align=left;verticalAlign=middle;fontSize=29;fontColor=#142437;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="19" width="1160" height="34" />
        </mxCell>
        <mxCell id="subtitle" value="GitHub CI checks the containers. Open the pipeline execution in the workshop Studio domain." style="text;align=left;verticalAlign=middle;fontSize=16;fontColor=#51647a;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="57" width="1160" height="22" />
        </mxCell>
        <mxCell id="note" value="The endpoint remains provisioned after the training and evaluation jobs end. Tear it down after the last invocation." style="text;align=left;verticalAlign=middle;fontSize=15;fontColor=#51647a;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="530" width="1160" height="24" />
        </mxCell>
        <mxCell id="pipeline-boundary" value="" style="rounded=1;arcSize=4;fillColor=#f4f8fc;strokeColor=#b2c4d8;strokeWidth=1.5;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="24" y="96" width="1212" height="246" />
        </mxCell>
        <mxCell id="pipeline-label" value="SageMaker Pipelines" style="text;align=left;verticalAlign=middle;fontSize=17;fontColor=#26384d;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="44" y="108" width="480" height="26" />
        </mxCell>
        <mxCell id="oidc-prerequisite" value="Before the first release, run GitHub IAM setup to configure the shared OIDC provider and deploy the workshop roles." style="text;align=left;verticalAlign=middle;fontSize=15;fontColor=#51647a;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="500" width="1160" height="24" />
        </mxCell>
        <mxCell id="promotion-label" value="Separate approval and deployment" style="text;align=left;verticalAlign=middle;fontSize=17;fontColor=#26384d;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="44" y="366" width="520" height="26" />
        </mxCell>
        <mxCell id="train" value="&lt;b&gt;TrainModel&lt;/b&gt;&lt;br&gt;Training job&lt;br&gt;Writes model.tar.gz to S3" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e6f4ef;strokeColor=#327d67;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="44" y="151" width="256" height="84" />
        </mxCell>
        <mxCell id="evaluate" value="&lt;b&gt;EvaluateModel&lt;/b&gt;&lt;br&gt;Processing job scores holdout&lt;br&gt;Writes evaluation.json to S3" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e6f4ef;strokeColor=#327d67;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="348" y="151" width="256" height="84" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;CheckBillingRecall&lt;/b&gt;&lt;br&gt;Reads the evaluation report&lt;br&gt;Minimum recall defaults to 0.50" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#566caf;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="652" y="151" width="256" height="84" />
        </mxCell>
        <mxCell id="register" value="&lt;b&gt;RegisterCandidate&lt;/b&gt;&lt;br&gt;Versioned Model Registry package&lt;br&gt;PendingManualApproval" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#566caf;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="956" y="151" width="256" height="84" />
        </mxCell>
        <mxCell id="reject" value="&lt;b&gt;RejectBelowThreshold&lt;/b&gt;&lt;br&gt;Execution fails before registration" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f4f6f9;strokeColor=#66758b;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="652" y="269" width="256" height="56" />
        </mxCell>
        <mxCell id="approve" value="&lt;b&gt;Instructor approves package&lt;/b&gt;&lt;br&gt;Reviews S3 report&lt;br&gt;Uses the versioned package ARN" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#566caf;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="956" y="405" width="256" height="84" />
        </mxCell>
        <mxCell id="deploy" value="&lt;b&gt;Manual GitHub Actions dispatch&lt;/b&gt;&lt;br&gt;Assumes deployment role with OIDC&lt;br&gt;Requires Approved and Completed" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#566caf;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="652" y="405" width="256" height="84" />
        </mxCell>
        <mxCell id="endpoint" value="&lt;b&gt;CloudFormation serving stack&lt;/b&gt;&lt;br&gt;Model → EndpointConfig → Endpoint&lt;br&gt;Waits for InService" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#566caf;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="348" y="405" width="256" height="84" />
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;Verify the deployed release&lt;/b&gt;&lt;br&gt;Signed InvokeEndpoint&lt;br&gt;Compare returned modelVersion" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e6f4ef;strokeColor=#327d67;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="44" y="405" width="256" height="84" />
        </mxCell>
        <mxCell id="train-evaluate" value="" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52667b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;labelBackgroundColor=#ffffff;fontColor=#34495e;" edge="1" parent="1" source="train" target="evaluate">
