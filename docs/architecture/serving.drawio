        </mxCell>
        <mxCell id="promote" value="&lt;b&gt;Keep candidate&lt;/b&gt;&lt;br&gt;Endpoint continues serving v2" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e6f4ef;strokeColor=#327d67;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1000" y="148" width="215" height="86" />
        </mxCell>
        <mxCell id="rollback" value="&lt;b&gt;SageMaker restores v1&lt;/b&gt;&lt;br&gt;Traffic goes back to the old fleet" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff1de;strokeColor=#92631b;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="671" y="336" width="228" height="81" />
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;Verify rollback&lt;/b&gt;&lt;br&gt;Baseline config and modelVersion" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#566caf;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1000" y="336" width="215" height="81" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
