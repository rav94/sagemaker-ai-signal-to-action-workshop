        <mxCell id="gate-reject" value="" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52667b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=0;labelBackgroundColor=#ffffff;fontColor=#34495e;" edge="1" parent="1" source="gate" target="reject">
