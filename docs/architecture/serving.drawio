  <diagram name="SageMaker guarded endpoint update" id="sagemaker-guarded-update">
    <mxGraphModel dx="1380" dy="650" grid="1" page="1" pageWidth="1260" pageHeight="500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
