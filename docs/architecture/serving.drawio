          <mxGeometry as="geometry" x="903.5" y="350" width="91" height="18" />
        </mxCell>
        <mxCell id="baseline" value="&lt;b&gt;Endpoint serves baseline&lt;/b&gt;&lt;br&gt;Version v1 is InService" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#566caf;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="148" width="215" height="86" />
        </mxCell>
        <mxCell id="candidate" value="&lt;b&gt;Update serves candidate&lt;/b&gt;&lt;br&gt;Same endpoint, new configuration&lt;br&gt;All traffic shifts to v2" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e6f4ef;strokeColor=#327d67;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
