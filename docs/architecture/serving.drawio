          <mxGeometry as="geometry" x="575.0" y="163" width="98" height="18" />
        </mxCell>
        <mxCell id="edge-2" value="" style="endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52667b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=0;labelBackgroundColor=#ffffff;fontColor=#34495e;" edge="1" parent="1" source="alarm" target="promote">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
