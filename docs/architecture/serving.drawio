        </mxCell>
        <mxCell id="alarm" value="&lt;b&gt;CloudWatch watches v2&lt;/b&gt;&lt;br&gt;ModelLatency for candidate config&lt;br&gt;Ten-minute fleet termination wait" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f4f6f9;strokeColor=#66758b;strokeWidth=1.5;fontColor=#26384d;fontSize=14;" vertex="1" parent="1">
